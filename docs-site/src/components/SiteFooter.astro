---
/**
 * The FMAD site footer: a dark steel ground and mono column headings that
 * close every page.
 *
 * It is rendered inside Starlight's `.main-pane` (see TwoColumnContent.astro),
 * not inside the content column, so the band spans the whole main column —
 * flush to the sidebar on one side and the table of contents on the other.
 * Its inner column reuses Starlight's own `--sl-content-margin-inline`, so the
 * text lines up with the article above it.
 *
 * It cannot run the full viewport width: Starlight's sidebar is
 * `position: fixed` and full height, so a 100vw band would sit behind it.
 */
const COLUMNS = [
  {
    heading: 'Method',
    links: [
      { href: '/build/build-a-change/', label: 'Build a change' },
      { href: '/build/review-a-change/', label: 'Review a change' },
      { href: '/reference/skills-and-agents/', label: 'Skills and agents' },
    ],
  },
  {
    heading: 'Teams',
    links: [
      { href: '/plan/plan-inside-an-organization/', label: 'Plan inside an organization' },
      { href: '/customize/adopt-fmad-across-a-team/', label: 'Adopt across a team' },
      { href: '/customize/customize-fmad/', label: 'Customization' },
    ],
  },
  {
    heading: 'Project',
    links: [
      { href: 'https://github.com/DavidBatoDev/fmad-method', label: 'GitHub' },
      { href: 'https://github.com/DavidBatoDev/fmad-method/discussions', label: 'Discussions' },
      { href: 'https://github.com/DavidBatoDev/fmad-method/issues', label: 'Issues' },
      { href: 'https://github.com/DavidBatoDev/fmad-method/tree/main/web-bundles', label: 'Web bundles' },
    ],
  },
];

const BOTTOM: { text: string; href?: string }[] = [
  { text: '© 2026 DavidBatoDev · © 2025 BMad Code, LLC' },
  { text: 'MIT licensed', href: 'https://github.com/DavidBatoDev/fmad-method/blob/main/LICENSE' },
  { text: 'Derived from BMAD-METHOD™ by BMad Code, LLC. Not affiliated.' },
];

/* Internal links keep the reader in their language. Every page here exists
   under each locale — Starlight generates the untranslated ones as fallbacks —
   so prefixing the locale is safe, and without it a French or Korean reader
   following the footer lands back in English. */
const { locale } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = locale ? `${base}/${locale}` : base;
const href = (link: string) => (link.startsWith('/') ? `${root}${link}` : link);
---

<div class="fmad-footer">
  <div class="inner">
  <p class="brand"><a href="https://github.com/DavidBatoDev/fmad-method">FMAD</a></p>
  <p class="tagline">
    Foundry Method for Agile AI-Driven Development. Turn an idea or change request into working
    software without giving up the thinking.
  </p>

  <div class="cols">
    {
      COLUMNS.map((col) => (
        // A nav labelled by its own visible text, not a heading. This footer
        // renders inside <main>, so an <h2> here joined the page's heading
        // outline and a reader skimming by heading met "Method" and
        // "Community" among the article's own sections.
        <nav aria-labelledby={`footer-${col.heading.toLowerCase()}`}>
          <p class="col-title" id={`footer-${col.heading.toLowerCase()}`}>
            {col.heading}
          </p>
          {col.links.map((link) => (
            <a href={href(link.href)}>{link.label}</a>
          ))}
        </nav>
      ))
    }
  </div>

  <p class="bottom">
    {BOTTOM.map((item) => (item.href ? <a href={item.href}>{item.text}</a> : <span>{item.text}</span>))}
  </p>
  </div>
</div>

<style>
  /* A full-bleed band, so it sits flush against the article rather than
     floating below it: its own top padding is the gap. */
  .fmad-footer {
    padding-block: clamp(2.8rem, 5vw, 3.6rem) 2.2rem;
    background: var(--fmad-dark, #111418);
    color: var(--fmad-dark-muted, #a2acb9);
  }

  /* On the dark ramp the band's ground is the page's ground, so there is no
     band at all - only an unexplained gap where one should start. Lift it a
     step and give it an edge. */
  :global(:root[data-theme='dark']) .fmad-footer {
    background: var(--fmad-dark-2, #1a1e24);
    border-top: 1px solid var(--fmad-dark-line, #2e353e);
  }

  /* the article's own column, so the footer text sits under the prose */
  .inner {
    max-width: var(--sl-content-width);
    margin-inline: var(--sl-content-margin-inline, auto);
    padding-inline: var(--sl-content-pad-x);
  }

  .brand {
    margin: 0;
  }

  .brand a {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #ffffff;
    text-decoration: none;
  }

  .tagline {
    margin: 0.9rem 0 0;
    max-width: 46ch;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: clamp(2.2rem, 4vw, 3rem);
  }

  .cols .col-title {
    margin: 0 0 0.9rem;
    font-family: var(--fmad-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .cols a {
    display: block;
    padding: 0.28rem 0;
    font-size: 0.9375rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .cols a:hover {
    color: #ffffff;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin: clamp(2.2rem, 4vw, 3rem) 0 0;
    padding-top: 1.3rem;
    border-top: 1px solid var(--fmad-dark-line, #2e353e);
    font-family: var(--fmad-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: #8c96a3;
  }

  .bottom a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .bottom a:hover {
    color: #ffffff;
  }

  /* One column, not two: there are three groups, so two always orphans one
     onto a row of its own and leaves the space beside it empty. */
  @media (max-width: 32rem) {
    .cols {
      grid-template-columns: 1fr;
      gap: 1.9rem;
    }
  }
</style>
